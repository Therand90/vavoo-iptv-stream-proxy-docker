# EN: Local listening address. Keep 127.0.0.1 unless a trusted private network needs access.
# FR : Adresse d'écoute locale. Gardez 127.0.0.1 sauf si un réseau privé de confiance doit y accéder.
VAVOO_BIND_ADDRESS=127.0.0.1
VAVOO_PORT=8899

# EN: Values sent to the upstream APIs.
# FR : Valeurs envoyées aux API amont.
VAVOO_LANGUAGE=en
VAVOO_REGION=US
VAVOO_URL_LIST=both

# EN: Channel-catalog cache duration in seconds. Minimum accepted value: 300.
# FR : Durée du cache du catalogue en secondes. Valeur minimale acceptée : 300.
VAVOO_CHANNELS_CACHE_TTL_SECONDS=21600

# EN: Local lifetime of a signed stream URL. Fifty minutes renews it before hourly expiry.
# FR : Durée de vie locale d'une URL signée. Cinquante minutes permettent son renouvellement avant l'expiration horaire.
VAVOO_STREAM_URL_TTL_SECONDS=3000

# EN: Lifetime of the last valid HLS playlist used during short upstream failures.
# FR : Durée de conservation de la dernière playlist HLS valide pendant une panne amont courte.
VAVOO_PLAYLIST_CACHE_TTL_SECONDS=300

# EN: Short cache lifetime and maximum size for successfully downloaded HLS media assets.
# FR : Durée du cache court et taille maximale des ressources média HLS téléchargées avec succès.
VAVOO_HLS_ASSET_CACHE_TTL_SECONDS=45
VAVOO_HLS_ASSET_MAX_CACHE_BYTES=12582912

# EN: Number of recent HLS media segments to prefetch. Set to 0 to disable.
# FR : Nombre de segments média HLS récents à précharger. Utilisez 0 pour désactiver.
VAVOO_HLS_PREFETCH_SEGMENT_COUNT=2

# EN: Temporary quarantine applied to ordinary failing variants inside a logical channel group.
# FR : Quarantaine temporaire appliquée aux variantes en échec classique dans un groupe logique.
VAVOO_VARIANT_QUARANTINE_SECONDS=300

# EN: Lightweight MPEG-TS/H.264 loop detector for logical VAVOO variants.
# EN: It requires two consecutive strong matches before quarantining a looping source.
# FR : Détecteur léger de boucle MPEG-TS/H.264 pour les variantes VAVOO logiques.
# FR : Deux correspondances fortes consécutives sont exigées avant la quarantaine d'une source qui boucle.
VAVOO_LOOP_DETECTION_ENABLED=true
VAVOO_LOOP_SIMILARITY_THRESHOLD=0.70
VAVOO_LOOP_MIN_COMMON_NALS=100
VAVOO_LOOP_CONFIRMATIONS=2
VAVOO_LOOP_HISTORY_SEGMENTS=8
VAVOO_LOOP_QUARANTINE_SECONDS=1800

# EN: Rank logical variants from real media metrics when no healthy active variant exists.
# EN: The proxy probes two recent segments, reads H.264 SPS resolution/frame-rate when available,
# EN: estimates bitrate from bytes/duration, and demotes a strong pre-flight loop suspect.
# FR : Classe les variantes logiques à partir des métriques média réelles lorsqu'aucune variante active saine n'existe.
# FR : Le proxy sonde deux segments récents, lit résolution/framerate depuis le SPS H.264 lorsque disponible,
# FR : estime le débit à partir des octets/durée et rétrograde une variante déjà fortement suspecte de boucle.
VAVOO_QUALITY_RANKING_ENABLED=true
VAVOO_QUALITY_CACHE_SECONDS=1800

# EN: Optional persistent HMAC secret for internal HLS proxy URLs (minimum 32 characters).
# EN: Leave empty for one container; generate one with: openssl rand -hex 32
# FR : Secret HMAC persistant facultatif pour les URL internes du proxy HLS (32 caractères minimum).
# FR : Laissez vide pour un seul conteneur ; générez-en un avec : openssl rand -hex 32
VAVOO_HLS_PROXY_SECRET=
