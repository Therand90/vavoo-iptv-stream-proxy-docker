# Adresse d'écoute locale.
# Garder 127.0.0.1 tant qu'aucun accès réseau privé n'est nécessaire.
VAVOO_BIND_ADDRESS=127.0.0.1
VAVOO_PORT=8899

# Paramètres envoyés aux API VAVOO.
VAVOO_LANGUAGE=en
VAVOO_REGION=US
VAVOO_URL_LIST=both

# Durée du cache du catalogue en secondes.
# Six heures évitent un rechargement bloquant pendant la lecture.
VAVOO_CHANNELS_CACHE_TTL_SECONDS=21600

# Durée de vie locale d'une URL de flux signée.
# Cinquante minutes forcent un renouvellement avant son expiration horaire.
VAVOO_STREAM_URL_TTL_SECONDS=3000
