# EN: Local listening address. Keep 127.0.0.1 unless a trusted private network needs access.
# FR : Adresse d'écoute locale. Gardez 127.0.0.1 sauf si un réseau privé de confiance doit y accéder.
VAVOO_BIND_ADDRESS=127.0.0.1

# EN: Optional second host address for a trusted private network (LibreELEC manager only).
# EN: Example for a dedicated WireGuard service address: 10.13.14.2
# FR : Deuxième adresse hôte facultative pour un réseau privé de confiance (gestionnaire LibreELEC uniquement).
# FR : Exemple pour une adresse de service WireGuard dédiée : 10.13.14.2
VAVOO_PRIVATE_BIND_ADDRESS=

VAVOO_PORT=8899

# EN: Values sent to the upstream APIs.
# FR : Valeurs envoyées aux API amont.
VAVOO_LANGUAGE=en
VAVOO_REGION=US
VAVOO_URL_LIST=both

# EN: Channel-catalog cache duration in seconds. Minimum accepted value: 300.
# FR : Durée du cache du catalogue en secondes. Valeur minimale acceptée : 300.
VAVOO_CHANNELS_CACHE_TTL_SECONDS=21600

# EN: Local lifetime of a signed stream URL. Fifty minutes renews it before hourly expiry.
# FR : Durée de vie locale d'une URL signée. Cinquante minutes permettent son renouvellement avant l'expiration horaire.
VAVOO_STREAM_URL_TTL_SECONDS=3000

# EN: Lifetime of the last valid HLS playlist used during short upstream failures.
# FR : Durée de conservation de la dernière playlist HLS valide pendant une panne amont courte.
VAVOO_PLAYLIST_CACHE_TTL_SECONDS=300

# EN: During established playback, start one backup playlist fetch only when the first request is still pending.
# EN: If no fresh playlist succeeds within the fast-fallback budget, immediately serve the last valid cached playlist.
# EN: Set the fast-fallback budget to 0 to restore the legacy playlist retry path.
# FR : Pendant une lecture établie, lance une seule requête playlist de secours uniquement si la première reste bloquée.
# FR : Si aucune playlist fraîche ne réussit avant le budget rapide, sert immédiatement la dernière playlist valide en cache.
# FR : Utilisez 0 pour le budget rapide afin de restaurer l'ancien chemin de retry des playlists.
VAVOO_PLAYLIST_HEDGE_DELAY_MS=1000
VAVOO_PLAYLIST_FAST_FALLBACK_MS=3000

# EN: Keep successful HLS media assets long enough for the live-edge safety buffer to consume prefetched segments.
# FR : Conserve les ressources média HLS assez longtemps pour que le tampon derrière le direct puisse consommer les segments préchargés.
VAVOO_HLS_ASSET_CACHE_TTL_SECONDS=120
VAVOO_HLS_ASSET_MAX_CACHE_BYTES=12582912

# EN: Number of recent HLS media segments to prefetch. Set to 0 to disable.
# FR : Nombre de segments média HLS récents à précharger. Utilisez 0 pour désactiver.
VAVOO_HLS_PREFETCH_SEGMENT_COUNT=2

# EN: Media-segment hedge delay while the player is waiting for an in-flight prefetch.
# FR : Délai avant requête de secours d'un segment média lorsque le lecteur attend un préchargement en cours.
VAVOO_HLS_PREFETCH_HEDGE_DELAY_MS=1500

# EN: Keep consumers this many prefetched segments behind the HLS live edge.
# EN: The delay is automatically reduced if the playlist is too short or prefetch depth is smaller.
# FR : Maintient les consommateurs autant de segments préchargés derrière le bord du direct HLS.
# FR : Le retard est automatiquement réduit si la playlist est trop courte ou si le préchargement est moins profond.
VAVOO_HLS_LIVE_EDGE_DELAY_SEGMENTS=2

# EN: Temporary quarantine applied to ordinary failing variants inside a logical channel group.
# FR : Quarantaine temporaire appliquée aux variantes en échec classique dans un groupe logique.
VAVOO_VARIANT_QUARANTINE_SECONDS=300

# EN: Keep the currently active logical variant during a brief stale-playlist period before allowing failover.
# EN: Eight seconds keeps one short transient outage tolerated without waiting long enough for Kodi to abandon playback.
# EN: Set to 0 to disable this grace period.
# FR : Conserve la variante logique actuellement active pendant une courte période de playlist périmée avant d'autoriser le failover.
# FR : Huit secondes tolèrent un incident très bref sans attendre assez longtemps pour que Kodi abandonne la lecture.
# FR : Utilisez 0 pour désactiver ce délai de grâce.
VAVOO_ACTIVE_STALE_GRACE_SECONDS=8

# EN: Treat a fresh HTTP-200 media playlist whose newest segment does not change for this many seconds as stalled.
# EN: This catches sources that stay reachable but stop advancing. Set to 0 to disable.
# FR : Considère comme figée une playlist média HTTP 200 dont le segment le plus récent n'avance plus pendant ce délai.
# FR : Cela détecte les sources encore joignables mais bloquées. Utilisez 0 pour désactiver.
VAVOO_LOGICAL_PLAYLIST_STALL_SECONDS=20

# EN: Lightweight MPEG-TS/H.264 loop detector for logical VAVOO variants.
# EN: A confirmed loop is quarantined for one day so it cannot repeatedly pollute failover during the same day.
# FR : Détecteur léger de boucle MPEG-TS/H.264 pour les variantes VAVOO logiques.
# FR : Une boucle confirmée est mise en quarantaine pendant une journée afin qu'elle ne revienne pas polluer les failovers de la même journée.
VAVOO_LOOP_DETECTION_ENABLED=true
VAVOO_LOOP_SIMILARITY_THRESHOLD=0.70
VAVOO_LOOP_MIN_COMMON_NALS=100
VAVOO_LOOP_CONFIRMATIONS=2
VAVOO_LOOP_HISTORY_SEGMENTS=8
VAVOO_LOOP_QUARANTINE_SECONDS=86400

# EN: Rank logical variants from real media metrics when no healthy active variant exists.
# EN: Two recent media segments are reused to read H.264 SPS resolution/frame-rate when available,
# EN: estimate bitrate from bytes/duration, and strongly demote a pre-flight loop suspect.
# EN: Once a healthy variant is active, quality ranking never switches away from it by itself, even when cached measurements expire.
# FR : Classe les variantes logiques à partir des métriques média réelles lorsqu'aucune variante active saine n'existe.
# FR : Deux segments média récents sont réutilisés pour lire résolution/framerate depuis le SPS H.264 lorsque disponible,
# FR : estimer le débit à partir des octets/durée et fortement rétrograder une variante déjà suspecte de boucle.
# FR : Une variante saine déjà active n'est jamais remplacée uniquement parce qu'une autre obtient un meilleur score, même lorsque les mesures en cache expirent.
VAVOO_QUALITY_RANKING_ENABLED=true
VAVOO_QUALITY_CACHE_SECONDS=1800

# EN: Reuse the same media samples to inspect HLS/ISO-639 audio-language metadata.
# EN: Preferred languages rank first, then unknown metadata, then a language known to be foreign.
# EN: A variant declaring a blocked language without any preferred language is excluded.
# FR : Réutilise les mêmes échantillons média pour lire les métadonnées de langue audio HLS/ISO-639.
# FR : Les langues préférées passent d'abord, puis une langue inconnue, puis une langue étrangère confirmée.
# FR : Une variante déclarant une langue bloquée sans langue préférée est exclue.
VAVOO_AUDIO_LANGUAGE_FILTER_ENABLED=true
VAVOO_AUDIO_PREFERRED_LANGUAGES=fra,fre,fr
VAVOO_AUDIO_BLOCKED_LANGUAGES=eng,en

# EN: Persistent logical-channel state file. The supplied Compose and LibreELEC manager mount /data on a named Docker volume.
# EN: This keeps the last healthy active variant and unexpired quarantines across container recreations/reboots.
# EN: A temporary fallback explicitly detected as a foreign language does not overwrite an existing preferred saved variant.
# FR : Fichier d'état persistant des chaînes logiques. Le Compose et le gestionnaire LibreELEC fournis montent /data sur un volume Docker nommé.
# FR : Cela conserve la dernière variante saine active et les quarantaines non expirées après recréation/redémarrage du conteneur.
# FR : Un secours temporaire explicitement détecté dans une langue étrangère n'écrase pas une préférence enregistrée existante.
VAVOO_LOGICAL_STATE_FILE=/data/logical-state.json

# EN: Optional persistent HMAC secret for internal HLS proxy URLs (minimum 32 characters).
# EN: Leave empty for one container; generate one with: openssl rand -hex 32
# FR : Secret HMAC persistant facultatif pour les URL internes du proxy HLS (32 caractères minimum).
# FR : Laissez vide pour un seul conteneur ; générez-en un avec : openssl rand -hex 32
VAVOO_HLS_PROXY_SECRET=
